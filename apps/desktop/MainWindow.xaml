<Window x:Class="Relaydesk.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Relaydesk" Height="820" Width="1280" MinHeight="650" MinWidth="980" Background="#0B1016" Foreground="#EAF0F7" FontFamily="Segoe UI">
  <Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#1A2532"/><Setter Property="Foreground" Value="#EAF0F7"/><Setter Property="BorderBrush" Value="#2B3B4C"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,8"/><Setter Property="Cursor" Value="Hand"/></Style><Style TargetType="TextBox"><Setter Property="Background" Value="#101923"/><Setter Property="Foreground" Value="#EAF0F7"/><Setter Property="BorderBrush" Value="#2B3B4C"/><Setter Property="Padding" Value="10,8"/></Style><Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D8E1EA"/><Setter Property="Margin" Value="0,8"/></Style></Window.Resources>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
    <Border Background="#0E151D" BorderBrush="#1F2C3A" BorderThickness="0,0,1,0"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="RELAYDESK" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="CONSENT-FIRST SUPPORT" Foreground="#7F93A8" FontSize="11" Margin="0,4,0,24"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="SUPPORT" Foreground="#71869B" FontSize="11" Margin="8,0,0,8"/><Border Background="#172536" CornerRadius="6" Padding="11"><TextBlock Text="Connect for support" FontWeight="SemiBold"/></Border><TextBlock Text="Session history" Margin="12,14,0,0"/><TextBlock Text="Trusted devices" Margin="12,14,0,0"/><TextBlock Text="Settings" Margin="12,14,0,0"/></StackPanel><StackPanel Grid.Row="2" VerticalAlignment="Bottom"><TextBlock Text="SESSION SAFETY" Foreground="#71869B" FontSize="11" Margin="8,0,0,10"/><TextBlock Text="No unattended access" Margin="12,0,0,10"/><TextBlock Text="No hidden capture" Margin="12,0,0,10"/><TextBlock Text="Local audit timeline" Margin="12,0,0,10"/></StackPanel><Border Grid.Row="3" Background="#101923" BorderBrush="#293A4C" BorderThickness="1" CornerRadius="6" Padding="12"><StackPanel><TextBlock Text="●  Ready" Foreground="#68D391" FontWeight="SemiBold"/><TextBlock Text="No connection is active" Foreground="#8294A7" FontSize="11" Margin="0,4,0,0"/></StackPanel></Border></Grid></Border>
    <Grid Grid.Column="1" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Connect for support" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Generate a local code, then decide exactly what a future session may request." Foreground="#91A3B6" Margin="0,5,0,0"/></StackPanel><Border Grid.Row="1" Background="#101923" BorderBrush="#2B3B4C" BorderThickness="1" CornerRadius="8" Margin="0,24,0,18" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="TEMPORARY PAIRING CODE" Foreground="#8398AD" FontSize="11"/><TextBlock x:Name="PairCode" FontSize="42" FontFamily="Consolas" FontWeight="SemiBold" Foreground="#71B7FF" Margin="0,8,0,0"/></StackPanel><StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right"><TextBlock x:Name="CodeExpiry" Foreground="#E5B45A" HorizontalAlignment="Right"/><TextBlock Text="LOCAL ONLY" Foreground="#8094A7" FontSize="11" HorizontalAlignment="Right" Margin="0,8,0,0"/></StackPanel></DockPanel><Border Grid.Row="1" Background="#0D141D" BorderBrush="#27394B" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,20,0,18"><TextBlock Text="This MVP does not transmit the code or open a remote connection. It only models the consent workflow locally." TextWrapping="Wrap" Foreground="#A3B3C1"/></Border><DockPanel Grid.Row="2"><TextBlock Text="Generate a new code when you are ready to review a session request." Foreground="#8EA2B5" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="End session" Click="End_Click" Margin="0,0,8,0"/><Button Content="Generate code" Click="Pair_Click" Background="#2878E8" BorderBrush="#4B96FF" FontWeight="SemiBold"/></StackPanel></DockPanel></Grid></Border><Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,10"><TextBlock Text="Local activity" FontSize="18" FontWeight="SemiBold"/><TextBlock DockPanel.Dock="Right" Text="PERSISTED ON THIS DEVICE" Foreground="#7E94AA" FontSize="11" VerticalAlignment="Center"/></DockPanel><TextBox Grid.Row="1" x:Name="Timeline" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#0E151D" BorderBrush="#2B3B4C"/></Grid></Grid>
    <Border Grid.Column="2" Background="#0E151D" BorderBrush="#1F2C3A" BorderThickness="1,0,0,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22"><TextBlock Text="Session permissions" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="EXPLICIT, REVOCABLE, SEPARATE" Foreground="#7890A6" FontSize="11" Margin="0,4,0,24"/><TextBlock Text="Requested capabilities" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Grant each capability independently. All are local UI state in this MVP." Foreground="#8DA0B4" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,12"/><Border Background="#121E2A" BorderBrush="#2B3B4C" BorderThickness="1" CornerRadius="6" Padding="14"><StackPanel><CheckBox x:Name="ViewConsent" Content="Allow screen viewing" Checked="ConsentChanged" Unchecked="ConsentChanged"/><Separator Margin="0,7" Background="#263747"/><CheckBox x:Name="InputConsent" Content="Allow input control" IsEnabled="False" Checked="ConsentChanged" Unchecked="ConsentChanged"/></StackPanel></Border><TextBlock x:Name="CapabilitySummary" Text="Granted capabilities: none" Foreground="#71B7FF" Margin="0,14,0,0"/><Border Background="#111A25" BorderBrush="#263B52" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,24,0,0"><StackPanel><TextBlock Text="Safety state" Foreground="#71B7FF" FontWeight="SemiBold"/><TextBlock Text="No screen capture, device connection, clipboard access, file transfer, or remote input exists in this release." TextWrapping="Wrap" Foreground="#A2B2C1" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></Border>
    <TextBlock Grid.Column="1" VerticalAlignment="Bottom" Margin="30" x:Name="Status" Foreground="#71B7FF"/>
  </Grid>
</Window>

